│   ├── public/
│   ├── src/
│   │   ├── components/    # Reusable UI components
│   │   ├── features/      # Redux slices or Zustand stores
│   │   ├── pages/         # Page-level components
│   │   ├── services/      # API & WebSocket clients
│   │   ├── utils/         # Helper functions
│   │   ├── App.jsx
│   │   ├── index.jsx
